begin_node_model "SurfaceArea"
BUILTIN
end_node_model

begin_node_model "coordinate_index"
DATAPARENT "x"
end_node_model

begin_node_model "drain_electron_bc"
COMMAND contact_node_model -device "MoS2_GAA" -contact "drain" -display_type "scalar" -name "drain_electron_bc" -equation "(Electrons - EquilibriumElectrons);"
end_node_model

begin_node_model "drain_electron_bc:Electrons"
COMMAND contact_node_model -device "MoS2_GAA" -contact "drain" -display_type "scalar" -name "drain_electron_bc:Electrons" -equation "1;"
end_node_model

begin_node_model "drain_potential_bc"
COMMAND contact_node_model -device "MoS2_GAA" -contact "drain" -display_type "scalar" -name "drain_potential_bc" -equation "(-(ThermalVoltage * log((EquilibriumElectrons * pow(IntrinsicDensity,(-1))))) - drain_bias + Potential);"
end_node_model

begin_node_model "drain_potential_bc:Potential"
COMMAND contact_node_model -device "MoS2_GAA" -contact "drain" -display_type "scalar" -name "drain_potential_bc:Potential" -equation "1;"
end_node_model

begin_node_model "node_index"
DATAPARENT "x"
end_node_model

begin_node_model "source_electron_bc"
COMMAND contact_node_model -device "MoS2_GAA" -contact "source" -display_type "scalar" -name "source_electron_bc" -equation "(Electrons - EquilibriumElectrons);"
end_node_model

begin_node_model "source_electron_bc:Electrons"
COMMAND contact_node_model -device "MoS2_GAA" -contact "source" -display_type "scalar" -name "source_electron_bc:Electrons" -equation "1;"
end_node_model

begin_node_model "source_potential_bc"
COMMAND contact_node_model -device "MoS2_GAA" -contact "source" -display_type "scalar" -name "source_potential_bc" -equation "(-(ThermalVoltage * log((EquilibriumElectrons * pow(IntrinsicDensity,(-1))))) - source_bias + Potential);"
end_node_model

begin_node_model "source_potential_bc:Potential"
COMMAND contact_node_model -device "MoS2_GAA" -contact "source" -display_type "scalar" -name "source_potential_bc:Potential" -equation "1;"
end_node_model


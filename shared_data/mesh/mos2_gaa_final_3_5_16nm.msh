begin_node_model "EquilibriumElectrons"
COMMAND node_model -device "MoS2_GAA" -region "MoS2" -display_type "scalar" -name "EquilibriumElectrons" -equation "(5.000000000000000e-01 * (NetDoping + pow((pow(NetDoping,2) + (4 * pow(IntrinsicDensity,2))),5.000000000000000e-01)));"
end_node_model

begin_node_model "EquilibriumHoles"
COMMAND node_model -device "MoS2_GAA" -region "MoS2" -display_type "scalar" -name "EquilibriumHoles" -equation "(pow(IntrinsicDensity,2) * pow(EquilibriumElectrons,(-1)));"
end_node_model

begin_node_model "Holes"
COMMAND node_model -device "MoS2_GAA" -region "MoS2" -display_type "scalar" -name "Holes" -equation "EquilibriumHoles;"
end_node_model

begin_node_model "NSurfaceNormal_x"
DATAPARENT "SurfaceArea"
end_node_model

begin_node_model "NSurfaceNormal_y"
DATAPARENT "SurfaceArea"
end_node_model

begin_node_model "NetDoping"
COMMAND node_model -device "MoS2_GAA" -region "MoS2" -display_type "scalar" -name "NetDoping" -equation "(Donors - Acceptors);"
end_node_model

begin_node_model "NodeVolume"
BUILTIN
end_node_model


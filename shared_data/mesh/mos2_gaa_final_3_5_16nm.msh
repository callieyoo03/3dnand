end_triangle_edge_model

begin_triangle_edge_model "ElementCylindricalNodeVolume@en1"
DATAPARENT "ElementCylindricalNodeVolume@en0"
end_triangle_edge_model

begin_triangle_edge_model "ElementEdgeCouple"
BUILTIN
end_triangle_edge_model

begin_triangle_edge_model "ElementNodeVolume"
BUILTIN
end_triangle_edge_model

begin_equation "PotentialEquation"
COMMAND equation -device "MoS2_GAA" -region "TunnelOxide" -name "PotentialEquation" -variable_name "Potential" -variable_update "log_damp" -node_model "" -edge_model "PotentialEdgeFlux" -edge_volume_model "" -element_model "" -volume_node0_model "" -volume_node1_model "" -time_node_model ""
end_equation


begin_node_model "SurfaceArea"
BUILTIN
end_node_model

begin_node_model "coordinate_index"
DATAPARENT "x"
end_node_model

begin_node_model "node_index"
DATAPARENT "x"
end_node_model

begin_node_model "x"
BUILTIN
end_node_model

begin_node_model "y"
DATAPARENT "x"
end_node_model

begin_node_model "z"
DATAPARENT "x"
end_node_model

begin_edge_model "CylindricalEdgeCouple"
DATAPARENT "ElementCylindricalEdgeCouple"
end_edge_model

begin_edge_model "CylindricalEdgeNodeVolume@n0"
DATAPARENT "ElementCylindricalNodeVolume@en0"
end_edge_model

begin_edge_model "CylindricalEdgeNodeVolume@n1"
DATAPARENT "CylindricalEdgeNodeVolume@n0"
end_edge_model

begin_edge_model "EdgeCouple"
BUILTIN
end_edge_model

begin_edge_model "EdgeInverseLength"
BUILTIN
end_edge_model

begin_edge_model "EdgeLength"
BUILTIN
end_edge_model

begin_edge_model "EdgeNodeVolume"
BUILTIN
end_edge_model

begin_edge_model "ElectricField"
COMMAND edge_model -device "MoS2_GAA" -region "CoreOxide" -name "ElectricField" -equation "((Potential@n0 - Potential@n1) * EdgeInverseLength);" -display_type "scalar"
end_edge_model

begin_edge_model "ElectricField:Potential@n0"
COMMAND edge_model -device "MoS2_GAA" -region "CoreOxide" -name "ElectricField:Potential@n0" -equation "EdgeInverseLength;" -display_type "scalar"
end_edge_model

begin_edge_model "ElectricField:Potential@n1"
COMMAND edge_model -device "MoS2_GAA" -region "CoreOxide" -name "ElectricField:Potential@n1" -equation "(-EdgeInverseLength);" -display_type "scalar"
end_edge_model

begin_edge_model "Potential@n0"
COMMAND edge_from_node_model -device "MoS2_GAA" -region "CoreOxide" -node_model "Potential"
end_edge_model

begin_edge_model "Potential@n1"
DATAPARENT "Potential@n0"
end_edge_model

begin_edge_model "PotentialEdgeFlux"
COMMAND edge_model -device "MoS2_GAA" -region "CoreOxide" -name "PotentialEdgeFlux" -equation "(Permittivity * ElectricField);" -display_type "scalar"
end_edge_model

begin_edge_model "PotentialEdgeFlux:Potential@n0"
COMMAND edge_model -device "MoS2_GAA" -region "CoreOxide" -name "PotentialEdgeFlux:Potential@n0" -equation "(Permittivity * EdgeInverseLength);" -display_type "scalar"
end_edge_model

begin_edge_model "PotentialEdgeFlux:Potential@n1"
COMMAND edge_model -device "MoS2_GAA" -region "CoreOxide" -name "PotentialEdgeFlux:Potential@n1" -equation "(-Permittivity * EdgeInverseLength);" -display_type "scalar"
end_edge_model

begin_edge_model "edge_index"
BUILTIN
end_edge_model

begin_edge_model "unitx"
BUILTIN
end_edge_model

begin_edge_model "unity"
DATAPARENT "unitx"
end_edge_model

begin_triangle_edge_model "ElectricFieldMagnitude"
COMMAND element_model -device "MoS2_GAA" -region "CoreOxide" -name "ElectricFieldMagnitude" -equation "pow((pow(ElectricField_x,2) + pow(ElectricField_y,2)),5.000000000000000e-01);"
end_triangle_edge_model

begin_triangle_edge_model "ElectricField_x"
COMMAND element_from_edge_model -device "MoS2_GAA" -region "CoreOxide" -edge_model "ElectricField"
end_triangle_edge_model

begin_triangle_edge_model "ElectricField_y"
DATAPARENT "ElectricField_x"
end_triangle_edge_model

begin_triangle_edge_model "ElementCylindricalEdgeCouple"
COMMAND element_cylindrical_edge_couple -device "MoS2_GAA" -region "CoreOxide"
end_triangle_edge_model

begin_triangle_edge_model "ElementCylindricalNodeVolume@en0"
COMMAND element_cylindrical_node_volume -device "MoS2_GAA" -region "CoreOxide"
end_triangle_edge_model

begin_triangle_edge_model "ElementCylindricalNodeVolume@en1"
DATAPARENT "ElementCylindricalNodeVolume@en0"
end_triangle_edge_model

begin_triangle_edge_model "ElementEdgeCouple"
BUILTIN
end_triangle_edge_model

begin_triangle_edge_model "ElementNodeVolume"
BUILTIN
end_triangle_edge_model

begin_equation "PotentialEquation"
COMMAND equation -device "MoS2_GAA" -region "CoreOxide" -name "PotentialEquation" -variable_name "Potential" -variable_update "log_damp" -node_model "" -edge_model "PotentialEdgeFlux" -edge_volume_model "" -element_model "" -volume_node0_model "" -volume_node1_model "" -time_node_model ""
end_equation

end_region

begin_region "GateMetal" "Metal"

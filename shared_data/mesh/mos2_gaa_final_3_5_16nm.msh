begin_node_model "y"
DATAPARENT "x"
end_node_model

begin_node_model "z"
DATAPARENT "x"
end_node_model

begin_edge_model "Bern01"
COMMAND edge_model -device "MoS2_GAA" -region "MoS2" -name "Bern01" -equation "B(vdiff);" -display_type "scalar"
end_edge_model

begin_edge_model "Bern01:Potential@n0"
COMMAND edge_model -device "MoS2_GAA" -region "MoS2" -name "Bern01:Potential@n0" -equation "(dBdx(vdiff) * vdiff:Potential@n0);" -display_type "scalar"
end_edge_model

begin_edge_model "Bern01:Potential@n1"
COMMAND edge_model -device "MoS2_GAA" -region "MoS2" -name "Bern01:Potential@n1" -equation "(-Bern01:Potential@n0);" -display_type "scalar"
end_edge_model

begin_edge_model "CylindricalEdgeCouple"
DATAPARENT "ElementCylindricalEdgeCouple"
end_edge_model

begin_edge_model "CylindricalEdgeNodeVolume@n0"
DATAPARENT "ElementCylindricalNodeVolume@en0"
end_edge_model

begin_edge_model "CylindricalEdgeNodeVolume@n1"
DATAPARENT "CylindricalEdgeNodeVolume@n0"
end_edge_model

begin_edge_model "EdgeCouple"
BUILTIN
end_edge_model

begin_edge_model "EdgeInverseLength"
BUILTIN
end_edge_model

begin_edge_model "EdgeLength"
BUILTIN
end_edge_model

begin_edge_model "EdgeNodeVolume"
BUILTIN
end_edge_model

begin_edge_model "ElectricField"
COMMAND edge_model -device "MoS2_GAA" -region "MoS2" -name "ElectricField" -equation "((Potential@n0 - Potential@n1) * EdgeInverseLength);" -display_type "scalar"
end_edge_model

begin_edge_model "ElectricField:Potential@n0"
COMMAND edge_model -device "MoS2_GAA" -region "MoS2" -name "ElectricField:Potential@n0" -equation "EdgeInverseLength;" -display_type "scalar"
end_edge_model

begin_edge_model "ElectricField:Potential@n1"
COMMAND edge_model -device "MoS2_GAA" -region "MoS2" -name "ElectricField:Potential@n1" -equation "(-EdgeInverseLength);" -display_type "scalar"
end_edge_model

begin_edge_model "ElectronCurrent"
COMMAND edge_model -device "MoS2_GAA" -region "MoS2" -name "ElectronCurrent" -equation "(ElectronCharge * ElectronMobility * V_t * EdgeInverseLength * kahan3((Electrons@n1 * Bern01), (Electrons@n1 * vdiff), (-Bern01 * Electrons@n0)));" -display_type "scalar"
end_edge_model

begin_edge_model "ElectronCurrent:Electrons@n0"
COMMAND edge_model -device "MoS2_GAA" -region "MoS2" -name "ElectronCurrent:Electrons@n0" -equation "((ElectronCharge * ElectronMobility * V_t * (-Bern01 - (Bern01:Electrons@n0 * Electrons@n0) + (Bern01 * Electrons@n1:Electrons@n0) + (Bern01:Electrons@n0 * Electrons@n1) + (Electrons@n1 * vdiff:Electrons@n0) + (Electrons@n1:Electrons@n0 * vdiff)) * EdgeInverseLength) + (ElectronCharge * ElectronMobility * V_t * EdgeInverseLength:Electrons@n0 * kahan3((Bern01 * Electrons@n1), (Electrons@n1 * vdiff), (-Bern01 * Electrons@n0))));" -display_type "scalar"
end_edge_model

begin_edge_model "ElectronCurrent:Electrons@n1"
COMMAND edge_model -device "MoS2_GAA" -region "MoS2" -name "ElectronCurrent:Electrons@n1" -equation "((ElectronCharge * ElectronMobility * V_t * (-(Bern01 * Electrons@n0:Electrons@n1) - (Bern01:Electrons@n1 * Electrons@n0) + (Bern01:Electrons@n1 * Electrons@n1) + (Electrons@n1 * vdiff:Electrons@n1) + Bern01 + vdiff) * EdgeInverseLength) + (ElectronCharge * ElectronMobility * V_t * EdgeInverseLength:Electrons@n1 * kahan3((Bern01 * Electrons@n1), (Electrons@n1 * vdiff), (-Bern01 * Electrons@n0))));" -display_type "scalar"
end_edge_model

begin_edge_model "ElectronCurrent:Holes@n0"
COMMAND edge_model -device "MoS2_GAA" -region "MoS2" -name "ElectronCurrent:Holes@n0" -equation "((ElectronCharge * ElectronMobility * V_t * (-(Bern01 * Electrons@n0:Holes@n0) - (Bern01:Holes@n0 * Electrons@n0) + (Bern01 * Electrons@n1:Holes@n0) + (Bern01:Holes@n0 * Electrons@n1) + (Electrons@n1 * vdiff:Holes@n0) + (Electrons@n1:Holes@n0 * vdiff)) * EdgeInverseLength) + (ElectronCharge * ElectronMobility * V_t * EdgeInverseLength:Holes@n0 * kahan3((Bern01 * Electrons@n1), (Electrons@n1 * vdiff), (-Bern01 * Electrons@n0))));" -display_type "scalar"
end_edge_model

begin_edge_model "ElectronCurrent:Holes@n1"
COMMAND edge_model -device "MoS2_GAA" -region "MoS2" -name "ElectronCurrent:Holes@n1" -equation "((ElectronCharge * ElectronMobility * V_t * (-(Bern01 * Electrons@n0:Holes@n1) - (Bern01:Holes@n1 * Electrons@n0) + (Bern01 * Electrons@n1:Holes@n1) + (Bern01:Holes@n1 * Electrons@n1) + (Electrons@n1 * vdiff:Holes@n1) + (Electrons@n1:Holes@n1 * vdiff)) * EdgeInverseLength) + (ElectronCharge * ElectronMobility * V_t * EdgeInverseLength:Holes@n1 * kahan3((Bern01 * Electrons@n1), (Electrons@n1 * vdiff), (-Bern01 * Electrons@n0))));" -display_type "scalar"
end_edge_model

begin_edge_model "ElectronCurrent:Potential@n0"
COMMAND edge_model -device "MoS2_GAA" -region "MoS2" -name "ElectronCurrent:Potential@n0" -equation "((ElectronCharge * ElectronMobility * V_t * (-(Bern01 * Electrons@n0:Potential@n0) - (Bern01:Potential@n0 * Electrons@n0) + (Bern01 * Electrons@n1:Potential@n0) + (Bern01:Potential@n0 * Electrons@n1) + (Electrons@n1 * vdiff:Potential@n0) + (Electrons@n1:Potential@n0 * vdiff)) * EdgeInverseLength) + (ElectronCharge * ElectronMobility * V_t * EdgeInverseLength:Potential@n0 * kahan3((Bern01 * Electrons@n1), (Electrons@n1 * vdiff), (-Bern01 * Electrons@n0))));" -display_type "scalar"
end_edge_model

begin_edge_model "ElectronCurrent:Potential@n1"
COMMAND edge_model -device "MoS2_GAA" -region "MoS2" -name "ElectronCurrent:Potential@n1" -equation "((ElectronCharge * ElectronMobility * V_t * (-(Bern01 * Electrons@n0:Potential@n1) - (Bern01:Potential@n1 * Electrons@n0) + (Bern01 * Electrons@n1:Potential@n1) + (Bern01:Potential@n1 * Electrons@n1) + (Electrons@n1 * vdiff:Potential@n1) + (Electrons@n1:Potential@n1 * vdiff)) * EdgeInverseLength) + (ElectronCharge * ElectronMobility * V_t * EdgeInverseLength:Potential@n1 * kahan3((Bern01 * Electrons@n1), (Electrons@n1 * vdiff), (-Bern01 * Electrons@n0))));" -display_type "scalar"
end_edge_model


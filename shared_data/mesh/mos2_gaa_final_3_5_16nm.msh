begin_edge_model "ElectricField"
COMMAND edge_model -device "MoS2_GAA" -region "TunnelOxide" -name "ElectricField" -equation "((Potential@n0 - Potential@n1) * EdgeInverseLength);" -display_type "scalar"
end_edge_model

begin_edge_model "ElectricField:Potential@n0"
COMMAND edge_model -device "MoS2_GAA" -region "TunnelOxide" -name "ElectricField:Potential@n0" -equation "EdgeInverseLength;" -display_type "scalar"
end_edge_model

begin_edge_model "ElectricField:Potential@n1"
COMMAND edge_model -device "MoS2_GAA" -region "TunnelOxide" -name "ElectricField:Potential@n1" -equation "(-EdgeInverseLength);" -display_type "scalar"
end_edge_model

begin_edge_model "Potential@n0"
COMMAND edge_from_node_model -device "MoS2_GAA" -region "TunnelOxide" -node_model "Potential"
end_edge_model

begin_edge_model "Potential@n1"
DATAPARENT "Potential@n0"
end_edge_model

begin_edge_model "PotentialEdgeFlux"
COMMAND edge_model -device "MoS2_GAA" -region "TunnelOxide" -name "PotentialEdgeFlux" -equation "(Permittivity * ElectricField);" -display_type "scalar"
end_edge_model

begin_edge_model "PotentialEdgeFlux:Potential@n0"
COMMAND edge_model -device "MoS2_GAA" -region "TunnelOxide" -name "PotentialEdgeFlux:Potential@n0" -equation "(Permittivity * EdgeInverseLength);" -display_type "scalar"
end_edge_model

begin_edge_model "PotentialEdgeFlux:Potential@n1"
COMMAND edge_model -device "MoS2_GAA" -region "TunnelOxide" -name "PotentialEdgeFlux:Potential@n1" -equation "(-Permittivity * EdgeInverseLength);" -display_type "scalar"
end_edge_model

begin_edge_model "edge_index"
BUILTIN
end_edge_model

begin_edge_model "unitx"
BUILTIN
end_edge_model

begin_edge_model "unity"
DATAPARENT "unitx"
end_edge_model

begin_triangle_edge_model "ElectricFieldMagnitude"
COMMAND element_model -device "MoS2_GAA" -region "TunnelOxide" -name "ElectricFieldMagnitude" -equation "pow((pow(ElectricField_x,2) + pow(ElectricField_y,2)),5.000000000000000e-01);"
end_triangle_edge_model

begin_triangle_edge_model "ElectricField_x"
COMMAND element_from_edge_model -device "MoS2_GAA" -region "TunnelOxide" -edge_model "ElectricField"
end_triangle_edge_model

begin_triangle_edge_model "ElectricField_y"
DATAPARENT "ElectricField_x"
end_triangle_edge_model

begin_triangle_edge_model "ElementCylindricalEdgeCouple"
